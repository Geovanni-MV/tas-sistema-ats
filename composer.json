{
  "name": "sr-reclutador/ats-template",
  "type": "project",
  "description": "Plantilla base ATS en Laravel con DTO, Service, Validators, Tailwind y DataTables.",
  "require": {
    "php": "^8.3",
    "laravel/framework": "^13.0"
  },
  "autoload": {
    "psr-4": {"App\\": "app/"}
  },
  "scripts": {
    "post-autoload-dump": ["Illuminate\\Foundation\\ComposerScripts::postAutoloadDump", "@php artisan package:discover --ansi"]
  },
  "minimum-stability": "stable",
  "prefer-stable": true
}
